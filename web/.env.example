# testnet | mainnet
VITE_NETWORK=testnet
# Factory contract address (printed by the deploy / testnetGraduation scripts)
VITE_FACTORY=
# Optional, lifts the 1 req/s Toncenter limit
VITE_TONCENTER_KEY=
# Wallet that receives STON.fi referral fees on post-graduation swaps
VITE_REFERRAL_ADDRESS=
# Public URL of tonconnect-manifest.json once hosted (defaults to <origin>/tonconnect-manifest.json)
VITE_MANIFEST_URL=
# Direct-launch factory (launch/); the Launch button stays disabled until it is set
VITE_LAUNCH_FACTORY=
# Marg DEX v2 Router (dex/v2). Unset: /swap, /pools and DEX token pages render, but every swap,
# deposit and withdraw button stays disabled ("Opens with Marg DEX") and the nav keeps its "soon" badges.
VITE_DEX_ROUTER=
