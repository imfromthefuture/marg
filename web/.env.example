# testnet | mainnet
VITE_NETWORK=mainnet
# MARG DEX Router and launch factory (see the README for the mainnet addresses)
VITE_DEX_ROUTER=
VITE_LAUNCH_FACTORY=
# 1: read Toncenter through /toncenter on the same origin (nginx adds the API key server-side)
VITE_TONCENTER_PROXY=
# Optional: a Toncenter API key used directly by the browser (prefer the proxy above)
VITE_TONCENTER_KEY=
# Public URL of tonconnect-manifest.json (defaults to <origin>/tonconnect-manifest.json)
VITE_MANIFEST_URL=
