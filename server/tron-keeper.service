[Unit]
Description=Marg keeper (collects launch taxes, runs due buybacks, releases escrowed launch fees, repairs reward views, watches Router rent)
After=network-online.target tron-indexer.service
Wants=tron-indexer.service

[Service]
User=tron-keeper
Group=tron-keeper
WorkingDirectory=/opt/tron-keeper
Environment=NETWORK=mainnet
Environment=INDEXER_URL=http://127.0.0.1:8811/api/idx/tokens?kind=dex
# Allowlist: only masters these factories derive are called (same list as the indexer).
Environment=LAUNCH_FACTORY=EQChP_pRE50KqE3QvRHwogpoCuIrp1To5sBckCIwNS1J27Ja
Environment=KEEPER_INTERVAL_SEC=600
Environment=KEEPER_MIN_TAX=0.5
Environment=KEEPER_MIN_BALANCE=0.3
Environment=KEEPER_MAX_TX=10
# Persisted state (last seen gas price, last rewards scan, status line): /var/lib/tron-keeper/keeper-state.json.
StateDirectory=tron-keeper
# KEEPER_MNEMONIC and TONCENTER_API_KEY live here: root-owned, mode 0600, never committed. The keeper must use
# its OWN Toncenter key, not the one nginx adds for the web proxy (audit R2-M4: separate rate limits).
EnvironmentFile=/etc/tron-keeper.env
ExecStart=/usr/bin/node /opt/tron-keeper/dist/keeper.js
Restart=always
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
